{
  "name": "cohorte",
  "version": "3.0.0-dev.5",
  "private": true,
  "description": "Cohorte V3: a durable multi-agent development pipeline with a runtime-independent orchestrator.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "cohorte": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "engines": {
    "node": "^24.16.0 || >=26.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBidouilleAgency/cohorte.git"
  },
  "homepage": "https://github.com/TheBidouilleAgency/cohorte#readme",
  "author": "Enzo Viry",
  "dependencies": {
    "@cohorte/base": "workspace:*",
    "@cohorte/config": "workspace:*",
    "@cohorte/core": "workspace:*",
    "@cohorte/git": "workspace:*",
    "@cohorte/persistence": "workspace:*",
    "@cohorte/project-model": "workspace:*",
    "@cohorte/protocol": "workspace:*",
    "@cohorte/providers": "workspace:*",
    "@cohorte/runtime-contract": "workspace:*",
    "@cohorte/runtime-fake": "workspace:*",
    "@cohorte/runtime-pi": "workspace:*",
    "@cohorte/security": "workspace:*",
    "@cohorte/telemetry": "workspace:*",
    "@cohorte/tools": "workspace:*",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "commander": "catalog:",
    "picomatch": "catalog:",
    "typebox": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@cohorte/testkit": "workspace:*"
  }
}
