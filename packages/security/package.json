{
  "name": "@cohorte/security",
  "version": "0.0.0",
  "private": true,
  "description": "Policy engine, gate stages, path and command policy, redactor, executor and sandbox backends, HMAC.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract/index.ts",
      "default": "./src/contract/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "dependencies": {
    "@cohorte/base": "workspace:*",
    "@cohorte/config": "workspace:*",
    "@cohorte/runtime-contract": "workspace:*",
    "picomatch": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@cohorte/testkit": "workspace:*"
  }
}
