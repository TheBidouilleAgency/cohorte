{
  "name": "@cohorte/persistence",
  "version": "0.0.0",
  "private": true,
  "description": "StateStore contract, memory and SQLite stores, migrations, blob store, run files, spool.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./conformance": {
      "types": "./src/conformance/index.ts",
      "default": "./src/conformance/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "dependencies": {
    "@cohorte/base": "workspace:*",
    "@cohorte/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cohorte/testkit": "workspace:*"
  }
}
