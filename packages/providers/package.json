{
  "name": "@cohorte/providers",
  "version": "0.0.0",
  "private": true,
  "description": "Tier to model resolution, provider allowlist, auth-mode policy, price catalogue, quota headers.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "dependencies": {
    "@cohorte/base": "workspace:*",
    "@cohorte/config": "workspace:*",
    "@cohorte/runtime-contract": "workspace:*"
  },
  "devDependencies": {
    "@cohorte/testkit": "workspace:*"
  }
}
