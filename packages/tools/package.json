{
  "name": "@cohorte/tools",
  "version": "0.0.0",
  "private": true,
  "description": "The tool catalogue: schemas, descriptions, implementations that run after the gate.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./catalogue": {
      "types": "./src/catalogue/index.ts",
      "default": "./src/catalogue/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "dependencies": {
    "@cohorte/base": "workspace:*",
    "@cohorte/git": "workspace:*",
    "@cohorte/persistence": "workspace:*",
    "@cohorte/protocol": "workspace:*",
    "@cohorte/runtime-contract": "workspace:*",
    "@cohorte/security": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@cohorte/testkit": "workspace:*"
  }
}
