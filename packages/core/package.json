{
  "name": "@cohorte/core",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-independent orchestration: state machine, phases, journal, tool host, approvals, resume.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract/index.ts",
      "default": "./src/contract/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "dependencies": {
    "@cohorte/base": "workspace:*",
    "@cohorte/config": "workspace:*",
    "@cohorte/git": "workspace:*",
    "@cohorte/persistence": "workspace:*",
    "@cohorte/project-model": "workspace:*",
    "@cohorte/protocol": "workspace:*",
    "@cohorte/providers": "workspace:*",
    "@cohorte/runtime-contract": "workspace:*",
    "@cohorte/security": "workspace:*",
    "@cohorte/telemetry": "workspace:*",
    "@cohorte/tools": "workspace:*",
    "picomatch": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@cohorte/runtime-fake": "workspace:*",
    "@cohorte/testkit": "workspace:*"
  }
}
