{
  "name": "@cohorte/telemetry",
  "version": "0.0.0",
  "private": true,
  "description": "Sealed NDJSON logger, usage accounting reducers, local metrics snapshot.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "dependencies": {
    "@cohorte/base": "workspace:*"
  },
  "devDependencies": {
    "@cohorte/testkit": "workspace:*"
  }
}
