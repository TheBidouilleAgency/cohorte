    "@cohorte/config": "workspace:*",
    "@cohorte/core": "workspace:*",
    "@cohorte/git": "workspace:*",
    "@cohorte/persistence": "workspace:*",
    "@cohorte/project-model": "workspace:*",
    "@cohorte/protocol": "workspace:*",
    "@cohorte/providers": "workspace:*",
    "@cohorte/runtime-contract": "workspace:*",
    "@cohorte/runtime-fake": "workspace:*",
    "@cohorte/runtime-pi": "workspace:*",
    "@cohorte/security": "workspace:*",
    "@cohorte/telemetry": "workspace:*",
    "@cohorte/tools": "workspace:*",
    "typebox": "catalog:",
    "yaml": "catalog:"
  }
}
