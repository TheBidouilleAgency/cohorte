{
  "name": "@cohorte/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only test utilities: hermetic git env, fixtures, fixed clock, fake brain, fake provider, runCli.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
