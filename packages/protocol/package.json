{
  "name": "@cohorte/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Frontier 2: the Cohorte Protocol v1.0 (envelope, vocabulary, event catalogue, commands, documents).",
  "license": "AGPL-3.0-only",
