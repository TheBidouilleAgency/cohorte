{
  "id": "claude",
  "label": "Claude Code",
  "docs": "https://docs.claude.com/en/docs/claude-code/slash-commands",
  "detect": [
    "~/.claude",
    "~/.config/claude"
  ],
  "scopes": {
    "global": {
      "root": "~/.claude",
      "core": "~/.claude",
      "commands": "~/.claude/commands",
      "agents": "~/.claude/agents",
      "hooks": "~/.claude/hooks",
      "workflows": "~/.claude/workflows",
      "settings": "~/.claude/settings.json",
      "hooks_config": "~/.claude/settings.json"
    },
    "project": {
      "root": ".claude",
      "core": ".claude",
      "commands": ".claude/commands",
      "agents": ".claude/agents",
      "hooks": ".claude/hooks",
      "workflows": ".claude/workflows",
      "settings": ".claude/settings.json",
      "hooks_config": ".claude/settings.json"
    }
  },
  "exclude_commands": [],
  "command": {
    "format": "md",
    "ext": ".md",
    "frontmatter": [
      "model",
      "description",
      "argument-hint",
      "allowed-tools",
      "disable-model-invocation"
    ],
    "args": "$ARGUMENTS",
    "invoke": "/<name>"
  },
  "agent": {
    "format": "md",
    "frontmatter": [
      "name",
      "description",
      "tools",
      "model"
    ],
    "dispatch": "Task tool, subagent_type: <name>",
    "address": "<name>",
    "ext": ".md"
  },
  "capabilities": {
    "subagents": true,
    "hooks": true,
    "workflows": true,
    "inline_design": true,
    "mcp": true,
    "tool_restriction": true
  },
  "memory": "CLAUDE.md",
  "headless": "claude -p",
  "hook": {
    "format": "claude",
    "event": "PreToolUse",
    "matcher": "Bash|Task",
    "supports_ask": true,
    "config_shape": "settings"
  }
}
