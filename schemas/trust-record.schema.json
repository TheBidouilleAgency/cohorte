{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/trust-record.schema.json",
  "title": "Cohorte trust record (~/.cohorte/trust/<projectKeyId>.json)",
  "type": "object",
  "required": [
    "policySha256",
    "loosenedKeys",
    "grantedAt",
    "grantedBy",
    "mac"
  ],
  "properties": {
    "policySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "loosenedKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grantedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "grantedBy": {
      "type": "string",
      "minLength": 1
    },
    "mac": {
      "type": "string",
      "minLength": 1
    }
  }
}
