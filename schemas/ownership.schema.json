{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/ownership.schema.json",
  "title": "Cohorte surface ownership map (.cohorte/ownership.yaml)",
  "type": "object",
  "required": [
    "surfaces"
  ],
  "properties": {
    "surfaces": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$": {
          "type": "object",
          "required": [
            "paths",
            "owners",
            "reviewers"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "owners": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reviewers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "approval": {
              "type": "string",
              "const": "human"
            }
          }
        }
      }
    }
  }
}
