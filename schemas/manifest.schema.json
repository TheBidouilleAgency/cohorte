{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/manifest.schema.json",
  "title": "Cohorte installation manifest (.cohorte/manifest.yaml)",
  "type": "object",
  "required": [
    "schemaVersion",
    "cohorteVersion",
    "createdWith",
    "protocol",
    "stateSchemaVersion",
    "generated"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "cohorteVersion": {
      "type": "string",
      "minLength": 1
    },
    "createdWith": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "string",
          "minLength": 1
        },
        "max": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateSchemaVersion": {
      "type": "integer",
      "minimum": 0
    },
    "generated": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "templateId",
          "templateSha256",
          "renderedSha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "templateId": {
            "type": "string",
            "minLength": 1
          },
          "templateSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "renderedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
