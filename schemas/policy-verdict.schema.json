{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/policy-verdict.schema.json",
  "title": "Cohorte policy verdict (policy explain)",
  "type": "object",
  "required": [
    "decision",
    "stage",
    "ruleId",
    "reason",
    "modelFacingReason",
    "overridable",
    "securityViolation",
    "asks",
    "evaluatedRules",
    "normalized"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "ask",
        "allow-once",
        "allow-for-run"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "liveness",
        "schema",
        "capability",
        "path",
        "command",
        "network",
        "budget",
        "approval"
      ]
    },
    "ruleId": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "modelFacingReason": {
      "type": "string"
    },
    "overridable": {
      "type": "boolean"
    },
    "securityViolation": {
      "type": "boolean"
    },
    "asks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "ruleId",
          "reason"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "liveness",
              "schema",
              "capability",
              "path",
              "command",
              "network",
              "budget",
              "approval"
            ]
          },
          "ruleId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "evaluatedRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalized": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "tool",
            "paths",
            "input",
            "grantKeyMaterial"
          ],
          "properties": {
            "tool": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "arg",
                  "resolved",
                  "intent"
                ],
                "properties": {
                  "arg": {
                    "type": "string"
                  },
                  "resolved": {
                    "type": "object",
                    "required": [
                      "canonical",
                      "relative",
                      "root",
                      "exists",
                      "viaSymlink"
                    ],
                    "properties": {
                      "canonical": {
                        "type": "string",
                        "minLength": 1
                      },
                      "relative": {
                        "type": "string"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 1
                      },
                      "exists": {
                        "type": "boolean"
                      },
                      "identity": {
                        "type": "object",
                        "required": [
                          "dev",
                          "ino",
                          "nlink"
                        ],
                        "properties": {
                          "dev": {
                            "type": "number"
                          },
                          "ino": {
                            "type": "number"
                          },
                          "nlink": {
                            "type": "number"
                          }
                        }
                      },
                      "viaSymlink": {
                        "type": "boolean"
                      }
                    }
                  },
                  "intent": {
                    "type": "string",
                    "enum": [
                      "read",
                      "write",
                      "create",
                      "list",
                      "exec-cwd"
                    ]
                  }
                }
              }
            },
            "command": {
              "type": "object",
              "required": [
                "file",
                "args",
                "cwd",
                "ruleId",
                "replay",
                "network",
                "timeoutMs"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "ruleId": {
                  "type": "string"
                },
                "replay": {
                  "type": "string",
                  "enum": [
                    "idempotent",
                    "at-most-once"
                  ]
                },
                "network": {
                  "type": "boolean"
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "input": {
              "$ref": "#/$defs/JsonValue"
            },
            "grantKeyMaterial": {
              "$ref": "#/$defs/JsonValue"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "approvalId": {
      "type": "string",
      "pattern": "^apr_[0-9a-f]{32}$"
    },
    "grantId": {
      "type": "string"
    }
  },
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/JsonValue"
            }
          }
        }
      ]
    }
  }
}
