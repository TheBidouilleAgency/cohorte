{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/project-status.schema.json",
  "title": "Cohorte project status (status --json)",
  "type": "object",
  "required": [
    "documentVersion",
    "protocolVersion",
    "project",
    "runs",
    "pendingApprovals"
  ],
  "properties": {
    "documentVersion": {
      "type": "number",
      "const": 1
    },
    "protocolVersion": {
      "type": "string",
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "root"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "runId",
          "profile",
          "title",
          "state",
          "status",
          "since",
          "startedAt"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^run_[0-9a-f]{32}$"
          },
          "profile": {
            "type": "string",
            "x-cohorte-known": [
              "feature",
              "bugfix",
              "review"
            ]
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "IDLE",
              "BRAINSTORM",
              "SPEC",
              "PREFLIGHT",
              "BUILD",
              "TEST",
              "REVIEW",
              "FIX",
              "SHIP",
              "PAUSED",
              "WAITING_APPROVAL",
              "AUTH_REQUIRED",
              "QUOTA_EXCEEDED",
              "FAILED",
              "BLOCKED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "paused",
              "waiting-approval",
              "cancelled",
              "skipped",
              "blocked"
            ]
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "stop": {
            "type": "object",
            "required": [
              "reason",
              "detail",
              "resumable"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "review-clean",
                  "iteration-limit",
                  "budget-exhausted",
                  "timeout",
                  "identical-failure",
                  "no-progress",
                  "policy-violation",
                  "approval-required",
                  "unexpected-repo-change",
                  "runtime-incompatible",
                  "auth-required",
                  "quota-exceeded",
                  "paused",
                  "cancelled",
                  "agent-dead",
                  "unreviewed",
                  "internal-error",
                  "check-environment"
                ]
              },
              "detail": {
                "type": "string"
              },
              "resumable": {
                "type": "boolean"
              },
              "resumeRequires": {
                "type": "string",
                "x-cohorte-known": [
                  "approval",
                  "auth-login",
                  "quota-reset",
                  "budget-raise",
                  "human-ack",
                  "repo-repair",
                  "reinstall-pinned-version",
                  "environment-repair"
                ]
              }
            }
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          }
        }
      }
    },
    "pendingApprovals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "approvalId",
          "kind",
          "what",
          "since",
          "cli"
        ],
        "properties": {
          "approvalId": {
            "type": "string",
            "pattern": "^apr_[0-9a-f]{32}$"
          },
          "kind": {
            "type": "string"
          },
          "agentId": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^agt_[A-Za-z0-9.-]+_[A-Za-z0-9_.-]+$"
          },
          "what": {
            "type": "string",
            "maxLength": 512
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "cli": {
            "type": "string"
          }
        }
      }
    }
  }
}
