{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/reconcile-plan.schema.json",
  "title": "Cohorte reconcile plan (reconcile --plan --json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "cohorteVersion",
    "generatedAt",
    "drift",
    "operations",
    "conflicts",
    "applyAvailable"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "cohorteVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "drift": {
      "type": "object",
      "required": [
        "schemaVersion",
        "generatedAt",
        "entries"
      ],
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "class",
              "diff",
              "detail"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "enum": [
                  "human",
                  "generated",
                  "derived",
                  "observed",
                  "mixed"
                ]
              },
              "diff": {
                "type": "string",
                "enum": [
                  "absent",
                  "expected-change",
                  "human-change",
                  "conflict",
                  "potential-deletion",
                  "unknown"
                ]
              },
              "desiredSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "actualSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "recordedSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op",
          "target",
          "diff",
          "reason"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "create",
              "replace",
              "delete",
              "keep",
              "ask"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "diff": {
            "type": "string",
            "enum": [
              "absent",
              "expected-change",
              "human-change",
              "conflict",
              "potential-deletion",
              "unknown"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applyAvailable": {
      "type": "boolean"
    }
  }
}
