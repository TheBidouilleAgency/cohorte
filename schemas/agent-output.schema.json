{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/agent-output.schema.json",
  "title": "Cohorte agent output (submit_result)",
  "type": "object",
  "required": [
    "status",
    "summary",
    "artifacts",
    "findings",
    "checks",
    "questions",
    "confidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "blocked",
        "needs-input"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "diff",
              "file",
              "test",
              "report",
              "contract"
            ]
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "kind",
          "rule",
          "expected",
          "actual",
          "confidence",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fnd_[0-9a-f]{16}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor",
              "info"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "spec-violation",
              "security",
              "quality",
              "complexity",
              "check-failure"
            ]
          },
          "rule": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              },
              "symbol": {
                "type": "string"
              }
            }
          },
          "reproduction": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "suggestedFix": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "in-scope",
              "deferred"
            ]
          },
          "outOfScopeReason": {
            "type": "string"
          }
        }
      },
      "maxItems": 30
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not-run"
            ]
          },
          "command": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap",
          "decision"
        ],
        "properties": {
          "gap": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        }
      }
    },
    "remediationAddressed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "findingId",
          "how"
        ],
        "properties": {
          "findingId": {
            "type": "string"
          },
          "how": {
            "type": "string"
          }
        }
      }
    }
  }
}
