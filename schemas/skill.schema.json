{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/skill.schema.json",
  "title": "Cohorte skill manifest (skills/<id>/skill.yaml)",
  "type": "object",
  "required": [
    "id",
    "version",
    "appliesWhen",
    "prompt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "appliesWhen": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packageManagers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "argv"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "signature": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  }
}
