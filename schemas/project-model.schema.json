{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/project-model.schema.json",
  "title": "Cohorte project model (discover --json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "stack",
    "surfaces",
    "commands",
    "testStrategy",
    "deploymentHints",
    "ownership",
    "risks",
    "conventions",
    "generatedArtifacts",
    "unknowns",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "root"
      ],
      "properties": {
        "id": {
          "type": "object",
          "required": [
            "value",
            "class",
            "provenance"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
            },
            "class": {
              "type": "string",
              "enum": [
                "human",
                "generated",
                "derived",
                "observed",
                "mixed"
              ]
            },
            "provenance": {
              "type": "object",
              "required": [
                "detector",
                "sources"
              ],
              "properties": {
                "detector": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "root": {
          "type": "object",
          "required": [
            "value",
            "class",
            "provenance"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "class": {
              "type": "string",
              "enum": [
                "human",
                "generated",
                "derived",
                "observed",
                "mixed"
              ]
            },
            "provenance": {
              "type": "object",
              "required": [
                "detector",
                "sources"
              ],
              "properties": {
                "detector": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "required": [
        "languages",
        "packageManager",
        "frameworks"
      ],
      "properties": {
        "languages": {
          "type": "object",
          "required": [
            "value",
            "class",
            "provenance"
          ],
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "class": {
              "type": "string",
              "enum": [
                "human",
                "generated",
                "derived",
                "observed",
                "mixed"
              ]
            },
            "provenance": {
              "type": "object",
              "required": [
                "detector",
                "sources"
              ],
              "properties": {
                "detector": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "packageManager": {
          "type": "object",
          "required": [
            "value",
            "class",
            "provenance"
          ],
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "class": {
              "type": "string",
              "enum": [
                "human",
                "generated",
                "derived",
                "observed",
                "mixed"
              ]
            },
            "provenance": {
              "type": "object",
              "required": [
                "detector",
                "sources"
              ],
              "properties": {
                "detector": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "frameworks": {
          "type": "object",
          "required": [
            "value",
            "class",
            "provenance"
          ],
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "class": {
              "type": "string",
              "enum": [
                "human",
                "generated",
                "derived",
                "observed",
                "mixed"
              ]
            },
            "provenance": {
              "type": "object",
              "required": [
                "detector",
                "sources"
              ],
              "properties": {
                "detector": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$": {
          "type": "object",
          "required": [
            "paths"
          ],
          "properties": {
            "paths": {
              "type": "object",
              "required": [
                "value",
                "class",
                "provenance"
              ],
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "class": {
                  "type": "string",
                  "enum": [
                    "human",
                    "generated",
                    "derived",
                    "observed",
                    "mixed"
                  ]
                },
                "provenance": {
                  "type": "object",
                  "required": [
                    "detector",
                    "sources"
                  ],
                  "properties": {
                    "detector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "value",
            "class",
            "provenance"
          ],
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "class": {
              "type": "string",
              "enum": [
                "human",
                "generated",
                "derived",
                "observed",
                "mixed"
              ]
            },
            "provenance": {
              "type": "object",
              "required": [
                "detector",
                "sources"
              ],
              "properties": {
                "detector": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "testStrategy": {
      "type": "object",
      "required": [
        "value",
        "class",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": "object",
          "required": [
            "runner",
            "locations"
          ],
          "properties": {
            "runner": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "class": {
          "type": "string",
          "enum": [
            "human",
            "generated",
            "derived",
            "observed",
            "mixed"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "detector",
            "sources"
          ],
          "properties": {
            "detector": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "deploymentHints": {
      "type": "object",
      "required": [
        "value",
        "class",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "string",
          "enum": [
            "human",
            "generated",
            "derived",
            "observed",
            "mixed"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "detector",
            "sources"
          ],
          "properties": {
            "detector": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "value",
        "class",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": "object",
          "required": [
            "codeowners"
          ],
          "properties": {
            "codeowners": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "class": {
          "type": "string",
          "enum": [
            "human",
            "generated",
            "derived",
            "observed",
            "mixed"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "detector",
            "sources"
          ],
          "properties": {
            "detector": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "message",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "message": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "conventions": {
      "type": "object",
      "required": [
        "value",
        "class",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "string",
          "enum": [
            "human",
            "generated",
            "derived",
            "observed",
            "mixed"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "detector",
            "sources"
          ],
          "properties": {
            "detector": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "generatedArtifacts": {
      "type": "object",
      "required": [
        "value",
        "class",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": "string",
          "enum": [
            "human",
            "generated",
            "derived",
            "observed",
            "mixed"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "detector",
            "sources"
          ],
          "properties": {
            "detector": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "candidates",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "generatedAt",
        "toolVersion",
        "analysis"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "toolVersion": {
          "type": "string"
        },
        "analysis": {
          "type": "string",
          "const": "deterministic"
        }
      }
    }
  }
}
