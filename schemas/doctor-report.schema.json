{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohorte.dev/schemas/3/doctor-report.schema.json",
  "title": "Cohorte doctor report (doctor --json)",
  "type": "object",
  "required": [
    "documentVersion",
    "cohorteVersion",
    "generatedAt",
    "ok",
    "checks",
    "sandbox",
    "runtimeCapabilities"
  ],
  "properties": {
    "documentVersion": {
      "type": "number",
      "const": 1
    },
    "cohorteVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "x-cohorte-known": [
              "ok",
              "warning",
              "error",
              "skipped"
            ]
          },
          "summary": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "sandbox": {
      "$ref": "#/$defs/JsonValue"
    },
    "runtimeCapabilities": {
      "$ref": "#/$defs/JsonValue"
    }
  },
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/JsonValue"
            }
          }
        }
      ]
    }
  }
}
