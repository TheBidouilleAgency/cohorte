{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!legacy",
      "!.cohorte",
      "!.build",
      "!**/dist",
      "!**/dist-types",
      "!**/node_modules",
      "!docs",
      "!assets",
      "!tsconfig.checks",
      "!schemas",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120, "lineEnding": "lf" },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": { "noFloatingPromises": "off" }
    }
  }
}
