# V3 build output. `.build/` holds gate builds, private unit builds and per-unit vitest caches;
# `dist-types/` is what `tsc -b` emits (declarations only); the three apps/cli directories are
# generated by scripts/build.ts.
.build/
.cohorte/state/
apps/cli/dist/
apps/cli/assets/
apps/cli/.publish/
*.tsbuildinfo
dist-types/

# V2 dogfooded its own /cohorte-init-pipeline: these are its rendered isolation scripts, with this
# repo's ports and paths baked in. The shipped V2 artifacts are the *.sh.template files beside them.
legacy/v2/scripts/new-feature.sh
legacy/v2/scripts/remove-feature.sh
.serena/
