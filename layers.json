{
  "$comment": "The package graph of DESIGN 1.1/1.2 as data. Read by scripts/check-layers.ts (the import scanner) and scripts/test/resolve-edges.test.ts (which proves every package.json and tsconfig.json agrees with it). Edge kinds: `normal` = value and type imports from src/**; `typeOnly` = `import type` only from src/**, restricted to the listed subpaths; `dev` = legal from test/** only (devDependencies). A structural file: only Wave 0 and the integrators edit it.",
  "version": 1,
  "scope": "@cohorte",
  "packages": {
    "@cohorte/base": {
      "dir": "packages/base",
      "layer": "L0",
      "entryPoints": {},
      "normal": [],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["typebox"],
      "declaredOnly": []
    },
    "@cohorte/runtime-contract": {
      "dir": "packages/runtime-contract",
      "layer": "L1",
      "entryPoints": {
        "./conformance": "./src/conformance/index.ts"
      },
      "normal": ["@cohorte/base"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["typebox"],
      "declaredOnly": []
    },
    "@cohorte/protocol": {
      "dir": "packages/protocol",
      "layer": "L1",
      "entryPoints": {},
      "normal": ["@cohorte/base"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["typebox"],
      "declaredOnly": []
    },
    "@cohorte/config": {
      "dir": "packages/config",
      "layer": "L2",
      "entryPoints": {
        "./schema": "./src/schema/index.ts"
      },
      "normal": ["@cohorte/base", "@cohorte/protocol"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["typebox", "yaml"],
      "declaredOnly": []
    },
    "@cohorte/persistence": {
      "dir": "packages/persistence",
      "layer": "L2",
      "entryPoints": {
        "./contract": "./src/contract.ts",
        "./conformance": "./src/conformance/index.ts"
      },
      "normal": ["@cohorte/base", "@cohorte/protocol"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": [],
      "declaredOnly": []
    },
    "@cohorte/security": {
      "dir": "packages/security",
      "layer": "L2",
      "entryPoints": {
        "./contract": "./src/contract/index.ts"
      },
      "normal": ["@cohorte/base", "@cohorte/runtime-contract", "@cohorte/config"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["picomatch", "typebox"],
      "declaredOnly": []
    },
    "@cohorte/git": {
      "dir": "packages/git",
      "layer": "L2",
      "entryPoints": {
        "./contract": "./src/contract.ts"
      },
      "normal": ["@cohorte/base"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": [],
      "declaredOnly": []
    },
    "@cohorte/providers": {
      "dir": "packages/providers",
      "layer": "L2",
      "entryPoints": {
        "./contract": "./src/contract.ts"
      },
      "normal": ["@cohorte/base", "@cohorte/runtime-contract", "@cohorte/config"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": [],
      "declaredOnly": []
    },
    "@cohorte/telemetry": {
      "dir": "packages/telemetry",
      "layer": "L2",
      "entryPoints": {
        "./contract": "./src/contract.ts"
      },
      "normal": ["@cohorte/base"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": [],
      "declaredOnly": []
    },
    "@cohorte/project-model": {
      "dir": "packages/project-model",
      "layer": "L2",
      "entryPoints": {
        "./contract": "./src/contract.ts"
      },
      "normal": ["@cohorte/base", "@cohorte/config", "@cohorte/git"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["typebox", "yaml"],
      "declaredOnly": []
    },
    "@cohorte/runtime-pi": {
      "dir": "packages/runtime-pi",
      "layer": "L2",
      "entryPoints": {
        "./host-protocol": "./src/protocol.ts"
      },
      "normal": ["@cohorte/base", "@cohorte/runtime-contract"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": [
        "typebox",
        "@earendil-works/pi-agent-core",
        "@earendil-works/pi-ai",
        "@earendil-works/pi-coding-agent"
      ],
      "declaredOnly": []
    },
    "@cohorte/runtime-fake": {
      "dir": "packages/runtime-fake",
      "layer": "L2",
      "entryPoints": {},
      "normal": ["@cohorte/base", "@cohorte/runtime-contract"],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["typebox", "yaml"],
      "declaredOnly": []
    },
    "@cohorte/tools": {
      "dir": "packages/tools",
      "layer": "L3",
      "entryPoints": {
        "./catalogue": "./src/catalogue/index.ts"
      },
      "normal": [
        "@cohorte/base",
        "@cohorte/runtime-contract",
        "@cohorte/protocol",
        "@cohorte/security",
        "@cohorte/git"
      ],
      "typeOnly": {
        "@cohorte/persistence": ["./contract"]
      },
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["typebox"],
      "declaredOnly": []
    },
    "@cohorte/core": {
      "dir": "packages/core",
      "layer": "L4",
      "entryPoints": {
        "./contract": "./src/contract/index.ts"
      },
      "normal": [
        "@cohorte/base",
        "@cohorte/runtime-contract",
        "@cohorte/protocol",
        "@cohorte/config",
        "@cohorte/security",
        "@cohorte/tools",
        "@cohorte/git",
        "@cohorte/providers",
        "@cohorte/telemetry",
        "@cohorte/project-model"
      ],
      "typeOnly": {
        "@cohorte/persistence": [".", "./contract", "./conformance"]
      },
      "dev": ["@cohorte/testkit", "@cohorte/runtime-fake", "@cohorte/persistence"],
      "thirdParty": ["typebox", "picomatch"],
      "declaredOnly": []
    },
    "cohorte": {
      "dir": "apps/cli",
      "layer": "L5",
      "entryPoints": {},
      "normal": [
        "@cohorte/base",
        "@cohorte/runtime-contract",
        "@cohorte/protocol",
        "@cohorte/config",
        "@cohorte/persistence",
        "@cohorte/security",
        "@cohorte/git",
        "@cohorte/tools",
        "@cohorte/providers",
        "@cohorte/telemetry",
        "@cohorte/project-model",
        "@cohorte/core",
        "@cohorte/runtime-pi",
        "@cohorte/runtime-fake"
      ],
      "typeOnly": {},
      "dev": ["@cohorte/testkit"],
      "thirdParty": ["commander", "yaml", "picomatch", "typebox"],
      "declaredOnly": ["@earendil-works/pi-agent-core", "@earendil-works/pi-ai", "@earendil-works/pi-coding-agent"]
    },
    "@cohorte/testkit": {
      "dir": "packages/testkit",
      "layer": "dev",
      "entryPoints": {},
      "normal": [
        "@cohorte/base",
        "@cohorte/runtime-contract",
        "@cohorte/protocol",
        "@cohorte/config",
        "@cohorte/persistence",
        "@cohorte/security",
        "@cohorte/git",
        "@cohorte/tools",
        "@cohorte/providers",
        "@cohorte/telemetry",
        "@cohorte/project-model",
        "@cohorte/core",
        "@cohorte/runtime-pi",
        "@cohorte/runtime-fake"
      ],
      "typeOnly": {},
      "dev": [],
      "thirdParty": ["typebox", "yaml"],
      "declaredOnly": []
    }
  },
  "root": {
    "$comment": "What the repository root declares for tests/** and scripts/**: every @cohorte/* package as a dev edge, plus the dev tools. Node resolves by walking up, so everything here is reachable from every package directory; that is why `devTools` are importable from the listed places only and why check-layers, not resolution, is what stops an undeclared workspace import.",
    "dev": [
      "@cohorte/base",
      "@cohorte/runtime-contract",
      "@cohorte/protocol",
      "@cohorte/config",
      "@cohorte/persistence",
      "@cohorte/security",
      "@cohorte/git",
      "@cohorte/tools",
      "@cohorte/providers",
      "@cohorte/telemetry",
      "@cohorte/project-model",
      "@cohorte/core",
      "@cohorte/runtime-pi",
      "@cohorte/runtime-fake",
      "@cohorte/testkit"
    ],
    "devTools": [
      "@biomejs/biome",
      "@types/node",
      "@types/picomatch",
      "ajv",
      "ajv-formats",
      "tsdown",
      "typescript",
      "vitest"
    ]
  },
  "thirdPartyUniverse": [
    "typebox",
    "yaml",
    "commander",
    "picomatch",
    "@earendil-works/pi-agent-core",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent"
  ],
  "rules": {
    "a": {
      "$comment": "Edges. `devToolImports`: shipped-tree places that may import a root dev tool (the conformance suites register vitest tests; testkit builds vitest fixtures).",
      "devToolImports": [
        {
          "paths": ["packages/runtime-contract/src/conformance/**"],
          "modules": ["vitest"]
        },
        {
          "paths": ["packages/persistence/src/conformance/**"],
          "modules": ["vitest"]
        },
        {
          "paths": ["packages/testkit/**"],
          "modules": ["vitest"]
        }
      ]
    },
    "b": {
      "$comment": "The engine is named in exactly one place.",
      "prefix": "@earendil-works/",
      "allowedIn": ["packages/runtime-pi/src/child/**", "packages/runtime-pi/test/**"]
    },
    "c": {
      "$comment": "core does no I/O of its own: every byte goes through a port.",
      "package": "@cohorte/core",
      "allowedNodeModules": ["node:path", "node:crypto", "node:events", "node:timers"]
    },
    "e": {
      "$comment": "Credential-reading identifiers (spec 10.1: never read nor export the token). Matched on the raw text, comments and strings included, so the rule stays checkable by grep.",
      "everywhere": ["readStoredCredential", "print-bearer-token", "print-api-key"],
      "scoped": [
        {
          "token": ".getAuth(",
          "in": ["packages/runtime-pi/src/**"]
        }
      ],
      "exempt": ["scripts/test/**"]
    },
    "f": {
      "$comment": "Only the redactor mints Sealed<T>; testkit's fakeRedactor is the one test-side exception.",
      "pattern": "as Sealed",
      "allowedIn": ["packages/security/src/redact/seal.ts", "packages/testkit/**"],
      "exempt": ["scripts/test/**"]
    },
    "g": {
      "$comment": "Lazy loading in shipped code, `import(` or `createRequire`: start-up laziness in the CLI, and the one file through which the child obtains Pi. testkit is dev-only and never bundled.",
      "allowedIn": ["apps/cli/src/lazy.ts", "packages/runtime-pi/src/child/load-pi.ts"],
      "exempt": ["packages/testkit/**"]
    },
    "h": {
      "$comment": "DESIGN 1.3: the CLI never passes a test entry to the Pi runtime.",
      "token": "entryOverride",
      "forbiddenIn": ["apps/cli/src/**"]
    }
  }
}
