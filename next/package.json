{
  "name": "cohorte-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "bin": {
    "cohorte-next": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:native": "node --test test/native.integration.ts",
    "test:profile": "node --test test/profile.integration.ts",
    "test:live": "node test/live.ts",
    "start": "node src/cli.ts"
  },
  "dependencies": {
    "ws": "8.21.3",
    "xstate": "5.33.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8",
    "typescript": "7.0.2"
  }
}
