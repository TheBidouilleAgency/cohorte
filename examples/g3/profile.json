{
  "schema_version": 1,
  "project_id": "g3-multisurface-demo",
  "name": "G3 disposable multi-surface demo",
  "language": "en",
  "metadata_mode": "local",
  "vcs": {
    "host": "other",
    "remote": "origin",
    "default_branch": "main",
    "feature_branch_prefix": "feature/",
    "patch_branch_prefix": "fix/"
  },
  "surfaces": [
    {
      "id": "contract",
      "label": "Shared contract",
      "paths": ["shared_contract.py"],
      "depends_on": [],
      "role_profile": "implementer",
      "check_ids": ["unit"],
      "uses_design": false
    },
    {
      "id": "backend",
      "label": "Backend consumer",
      "paths": ["backend.py", "test_backend.py"],
      "depends_on": ["contract"],
      "role_profile": "implementer",
      "check_ids": ["unit"],
      "uses_design": false
    },
    {
      "id": "client",
      "label": "Client consumer",
      "paths": ["client.py", "test_client.py"],
      "depends_on": ["contract"],
      "role_profile": "implementer",
      "check_ids": ["unit"],
      "uses_design": false
    }
  ],
  "checks": [
    {
      "id": "unit",
      "argv": ["python3", "-m", "unittest", "-v"],
      "cwd": ".",
      "timeout_seconds": 30,
      "required": true,
      "scope": "project",
      "environment_ref": null,
      "produces": []
    }
  ],
  "contract": {"enabled": true, "mechanism": "python-module", "paths": ["shared_contract.py"]},
  "execution": {"mode": "local", "dependency_setup": null},
  "agent_defaults": {
    "provider": "codex",
    "account_ref": "codex-native",
    "model": null,
    "role_profile": "implementer"
  },
  "policy": {
    "auth_mode": "subscription_only",
    "max_fix_cycles": 2,
    "max_parallel_per_account": 2,
    "max_parallel_global": 3,
    "require_frozen_spec": true,
    "review_blocking_severities": ["critical", "high"],
    "ship_authorization": "explicit_or_pregranted"
  },
  "integrations": {
    "retrieval": {"provider": "none"},
    "design": {"enabled": false},
    "rbac": {"enabled": false},
    "kanban": {"enabled": false},
    "release_notes": {"enabled": false}
  }
}
