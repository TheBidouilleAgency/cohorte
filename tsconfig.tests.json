{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "packages/*/test/**/*",
    "apps/*/test/**/*",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.itest.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/src/**/*.itest.ts",
    "tests/**/*",
    "scripts/**/*",
    "packages/testkit/**/*",
    "fixtures/**/*.ts",
    "vitest*.config.ts",
    "apps/*/*.config.ts"
  ],
  "exclude": [".cohorte/**", ".build/**", "**/dist/**", "**/dist-types/**", "**/node_modules/**"]
}
